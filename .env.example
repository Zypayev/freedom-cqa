# Скопируйте в .env и заполните.

# --- LLM ---
# ollama (локальная модель, используется командой, $0) или anthropic (облако)
CQA_PROVIDER=ollama
ANTHROPIC_API_KEY=
CQA_MODEL=claude-opus-5-5
# Глубина рассуждения модели: low | medium | high | xhigh | max
CQA_EFFORT=high
# Прогонов на диалог по умолчанию (голосование большинством). 3–5 для контрольного набора.
CQA_VOTES=1
# Параллельных диалогов при пакетной оценке
CQA_CONCURRENCY=2
# Серверный fallback Anthropic при отказе модели (1/0)
CQA_FALLBACKS=1

# Локальная модель (если CQA_PROVIDER=ollama). Для сервера с GPU укажите его адрес,
# например через SSH-туннель: ssh -N -L 11434:localhost:11434 user@gpu-server
OLLAMA_URL=http://localhost:11434
# RTX 4070 12 ГБ: qwen3:14b (точнее) или qwen3:8b (быстрее)
CQA_OLLAMA_MODEL=qwen3:14b
CQA_OLLAMA_NUM_CTX=16384
CQA_OLLAMA_THINK=0
# Для одной видеокарты держите CQA_CONCURRENCY=1–2

# --- Данные ---
# Адрес GET API организаторов. {group_id} будет подставлен; без него group_id уйдёт параметром запроса.
CQA_DATASET_URL=
# Путь к базе SQLite
# CQA_DB_PATH=data/cqa.sqlite3
